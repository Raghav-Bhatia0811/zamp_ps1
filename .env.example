# Copy to .env and fill in. Leave the key empty to run with the offline OCR reader only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
DEMO_PACING_MS=450
# Host port. Pick one that is free on your server (check with: ss -ltnp)
PORT=8000
# 127.0.0.1 = reachable only via Tailscale Funnel / a reverse proxy. 0.0.0.0 = open on the LAN too.
BIND=127.0.0.1
